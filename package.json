{
  "name": "kurio-nft-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "build:browser-test": "tsc -b && vite build --mode browser-test --configLoader runner",
    "build:audit": "tsc -b && vite build --mode audit --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -b --pretty",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint .",
    "test:e2e": "npm run build:browser-test && playwright test --config=playwright.e2e.config.ts",
    "test:e2e:report": "playwright show-report",
    "test:api": "playwright test --config=playwright.config.ts",
    "test:mock-browser": "npm run build:browser-test && playwright test --config=playwright.browser.config.ts",
    "realtime:dev": "node --experimental-strip-types server/realtime/index.ts",
    "test:realtime": "node --experimental-strip-types --test tests/realtime/server.spec.ts tests/realtime/querySync.spec.ts",
    "audit:lighthouse": "npm run build:audit && node scripts/lighthouse-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.132.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.35.0",
    "lighthouse": "^12.8.2",
    "msw": "^2.11.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
